# SnappyMail upstream rules
*.bak
*.old
/api.php
/*.log
/snappymail/v/0.0.0/static/*
!/snappymail/v/0.0.0/static/sounds/
snappymail/v/0.0.0/static/sounds/*
!/snappymail/v/0.0.0/static/sounds/chime.mp3
!/snappymail/v/0.0.0/static/sounds/chime.ogg
!/snappymail/v/0.0.0/static/logo-text.png
!/snappymail/v/0.0.0/static/fonts/
!/snappymail/v/0.0.0/static/fonts/Rubik/
!/snappymail/v/0.0.0/static/fonts/Rubik/Rubik-VariableFont_wght.ttf
!/snappymail/v/0.0.0/static/fonts/Rubik/OFL.txt
!/snappymail/v/0.0.0/static/images/
/snappymail/v/0.0.0/static/images/*
!/snappymail/v/0.0.0/static/images/background.jpg
!/snappymail/v/0.0.0/static/images/petuja-systems-logo.svg
!/snappymail/v/0.0.0/static/images/ui-icons/
!/snappymail/v/0.0.0/static/images/ui-icons/*.svg
/node_modules
/build/local
/build/dist
/build/tmp
/build/docker
/.docker/dev/.cache
/.docker/dev/mail/config
/.docker/dev/nginx/ssl/*
!/.docker/dev/nginx/ssl/.gitempty
/.docker/release/snappymail-*.zip
/dist
/data
/MULTIPLY
/include.php
/issues
.idea/
.env
/test
/public_html
/vendors/knockout/spec
/vendors/openpgp-5
!/vendors/openpgp-5/dist
/vendors/squire2
!/vendors/squire2/dist
/vendors/vanillaqr.js/
/integrations/nextcloud/rainloop
/integrations/owncloud/rainloop

# Operating-system metadata
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor and local-development metadata
.vscode/
*.swp
*.swo
*~
.phpunit.result.cache
coverage/
.cache/

# Local configuration, credentials, and secret material
.env.*
!.env.example
!.env.dist
**/credentials/
**/secrets/
**/private/
*.secret
*.token
*.key
*.pem
*.p12
*.pfx
*.pkcs12
*.jks
/snappymail/v/*/app/libraries/snappymail/smime/*.crt
/snappymail/v/*/app/libraries/snappymail/smime/*.cer

# Private OpenPGP demo fixtures are not part of the source release.
examples/crypto/*-private.asc
examples/crypto/smime.crt

# SnappyMail runtime/application data
/snappymail-data/
/runtime/
/storage/
/logs/
/log/
/cache/
/tmp/
/temp/
*.log

# Reproducible dependency directories and generated output
node_modules/
bower_components/
vendor/

# Backups, database dumps, and transient archives
*.backup
*.orig
*.save
*.dump
*.sql
*.sqlite
*.sqlite3
*.db
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# The SnappyMail snapshot's shipped compressed assets (*.gz/*.br) are
# intentional release files; they are not ignored by this rule set.
